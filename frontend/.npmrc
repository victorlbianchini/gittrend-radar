# Blindagem automatica contra ataques de cadeia de suprimentos (Black October 2026)
# Impede execucao automatica de scripts em preinstall, postinstall e build
ignore-scripts=true

# Forca instalacao com versoes exatas no package.json (bloqueia prefixos ^ e ~)
save-exact=true

# Alerta e bloqueia se houver vulnerabilidades criticas ou altas
audit-level=high

# Registrador oficial estrito
registry=https://registry.npmjs.org/

# Exige e valida a presenca do arquivo de lock
package-lock=true
